{
    "name": "velososolution/ia-zest-api",
    "description": "API REST de clientes (login JWT + cadastro) — IA-ZEST",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "firebase/php-jwt": "^7.0",
        "predis/predis": "^2.3",
        "robmorgan/phinx": "^0.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "migrate": "phinx migrate -c phinx.php",
        "seed": "phinx seed:run -c phinx.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": { "php": "8.4.0" }
    }
}
